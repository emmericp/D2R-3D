load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")

# bazel build //standalone:dist
# Output: bazel-bin/standalone/d2r-3d.zip (d2r-3d.exe + d2r-3d.dll + MinHook license)
#   -> extract into the D2R folder.

cc_binary(
    name = "d2r-3d.dll",
    srcs = ["d2r3d.cpp"],
    copts = [
        "/utf-8",
        "/W3",
        "/EHsc",
        "/permissive-",
    ],
    linkopts = ["user32.lib"],
    linkshared = True,
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["//standalone/third_party/minhook"],
)

pkg_files(
    name = "dist_binaries",
    srcs = [
        ":d2r-3d.dll",
        "//standalone/launcher:d2r-3d",
    ],
)

# MinHook is linked into d2r-3d.dll; its BSD-2-Clause license must ship with the binary.
pkg_files(
    name = "dist_licenses",
    srcs = ["//standalone/third_party/minhook:LICENSE.txt"],
    renames = {"//standalone/third_party/minhook:LICENSE.txt": "LICENSE-MinHook.txt"},
)

pkg_zip(
    name = "dist",
    srcs = [
        ":dist_binaries",
        ":dist_licenses",
    ],
    package_file_name = "d2r-3d.zip",
)
